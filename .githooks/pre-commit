#!/bin/sh
# Blocks a commit when web/index.md is out of sync with web/index.html, or when a prompt in
# web/index.html names a file or heading that no longer exists (docs and AGENTS.md can break it).
# Enable with: git config core.hooksPath .githooks
if git diff --cached --name-only | grep -qE '^(web/index\.(html|md)|AGENTS\.md|docs/.*)$'; then
  if ! python3 scripts/build-index-md.py --check; then
    echo "Fix the problem above. Regenerate index.md with: python3 scripts/build-index-md.py && git add web/index.md" >&2
    exit 1
  fi
fi
