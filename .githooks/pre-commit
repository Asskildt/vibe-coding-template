#!/bin/sh
# Blocks a commit when web/index.md is out of sync with web/index.html.
# Enable with: git config core.hooksPath .githooks

if git diff --cached --name-only | grep -qE '^web/index\.(html|md)$'; then
  if ! python3 scripts/build-index-md.py --check; then
    echo "Fix: python3 scripts/build-index-md.py && git add web/index.md" >&2
    exit 1
  fi
fi
